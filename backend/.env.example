# Database
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./dev.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql://user:password@host:5432/app_garden

# Auth (optional — omit both to disable auth entirely)
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# CORS origins (for local dev with Vite on :5173)
CORS_ORIGINS=["http://localhost:5173"]

# Path to built frontend dist (relative to where uvicorn runs)
STATIC_DIR=../frontend/dist
